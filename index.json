:"text","value":"measurement ","key":"mNNS5AASQz"},{"type":"emphasis","children":[{"type":"text","value":"y","key":"pGXqRB5sQ9"}],"key":"dIJhbXWd2D"},{"type":"subscript","children":[{"type":"text","value":"t","key":"dCjgJSzK8u"}],"key":"MbtiUhtsvF"}],"key":"rI4Z4mBvli"}],"key":"fCpsHD72ls"},{"type":"div","class":"interaction-node interaction-node-world","children":[{"type":"span","children":[{"type":"text","value":"Plant","key":"HLT3RSLd8o"}],"key":"lC8G5wWr7G"},{"type":"text","value":" ","key":"vBHYD6jum8"},{"type":"span","class":"interaction-node-subtitle","children":[{"type":"text","value":"dynamics ","key":"AmcLm1Zar6"},{"type":"emphasis","children":[{"type":"text","value":"f","key":"sSWoSg02Oe"}],"key":"FwX5ElZIwH"}],"key":"q4OVCVVQO4"}],"key":"b8EwXjEK2H"}],"key":"X2p3LBdgn3"},{"type":"paragraph","children":[{"type":"text","value":"Which feedback law makes the plant meet its specification?","key":"It03UuKzzy"}],"key":"TA2wqQVLE2"},{"type":"div","class":"interaction-context","children":[{"type":"text","value":"reference · disturbances · cost · constraints","key":"YRTiy5UOWy"}],"key":"U4pCevQNzs"}],"key":"lsLJF0EVO0"},{"type":"div","class":"interaction-lens","children":[{"type":"div","class":"interaction-lens-title","children":[{"type":"text","value":"OR and econometrics","key":"k5oBAl17G7"}],"key":"ZC8U3TsWy2"},{"type":"div","class":"interaction-loop","children":[{"type":"div","class":"interaction-node","children":[{"type":"span","children":[{"type":"text","value":"Decision rule","key":"M2hYFknRHR"}],"key":"rA6Y8YzEAi"},{"type":"text","value":" ","key":"wa3OfHHU6F"},{"type":"span","class":"interaction-node-subtitle","children":[{"type":"text","value":"objective + constraints","key":"fqw3JgvQTN"}],"key":"zSe8MTVNdO"}],"key":"YV7yNH0Ldc"},{"type":"div","class":"interaction-arrows","children":[{"type":"span","children":[{"type":"text","value":"decision ","key":"hXgL37iks1"},{"type":"emphasis","children":[{"type":"text","value":"d","key":"wLeOlzXirv"}],"key":"pEEjkfqokp"},{"type":"subscript","children":[{"type":"text","value":"t","key":"vgaovb402J"}],"key":"Ic6TfYIggN"}],"key":"ZdpHeRRRBE"},{"type":"div","class":"interaction-arrow-glyph","children":[{"type":"span","children":[{"type":"text","value":"→","key":"LiBATZ4y5W"}],"key":"yOx4OUGDsL"},{"type":"span","children":[{"type":"text","value":"←","key":"tRkOBssnGI"}],"key":"XNVm7o19R0"}],"key":"D5cnazC2jE"},{"type":"span","children":[{"type":"text","value":"covariates and","key":"LQFmN63GZo"},{"type":"break","key":"H2ihcAKJb5"},{"type":"text","value":"outcome","key":"E2tWJ6plSt"}],"key":"q1F66bIVNb"}],"key":"VlFOPtxjBJ"},{"type":"div","class":"interaction-node interaction-node-world","children":[{"type":"span","children":[{"type":"text","value":"System or population","key":"EAiJkXUbzf"}],"key":"d4ZwIPu7tc"},{"type":"text","value":" ","key":"vVXmkD47ev"},{"type":"span","class":"interaction-node-subtitle","children":[{"type":"text","value":"data-generating process","key":"oPvrKPfpae"}],"key":"KnKWJwLdBj"}],"key":"LGmKcmTIXz"}],"key":"B3hkOMFD6r"},{"type":"paragraph","children":[{"type":"text","value":"What would each feasible intervention cause, and which should be selected?","key":"vsH0ve2S3l"}],"key":"Kdeya5gLAy"},{"type":"div","class":"interaction-context","children":[{"type":"text","value":"shocks · feasibility · causal assumptions · welfare","key":"htwNj3j4ob"}],"key":"hGOgjKqoys"}],"key":"jDavO4rcXk"}],"key":"Q6nO8MCMJ7"},{"type":"div","class":"interaction-lenses-caption","children":[{"type":"strong","children":[{"type":"text","value":"Three vocabularies for a shared causal interaction.","key":"QHrS1H7JL4"}],"key":"SQhqWR8Ocd"},{"type":"text","value":" Reinforcement learning describes an agent acting in an environment; control theory describes a controller acting on a plant; operations research and econometrics describe decisions or interventions applied to an evolving system. The correspondence is structural rather than exact: a measurement need not reveal the state, a reward or cost must be specified, and econometric counterfactuals require identification assumptions. The reinforcement-learning panel follows the interaction convention of Sutton and Barto (2018).","key":"Oi09VkgBIB"}],"key":"svPl5OBokU"}],"html_id":"fig-interaction-loop-vocabularies","key":"pfwzRDL7fq"},{"type":"paragraph","position":{"start":{"line":131,"column":1},"end":{"line":135,"column":1}},"children":[{"type":"text","value":"The three panels describe related causal exchanges, but their terms are not\ninterchangeable. A sensor measurement may not reveal the system state, a reward\nor cost must be chosen, and causal claims from observational data require\nidentification assumptions. Moving between the vocabularies is useful only when\nthese differences remain explicit.","position":{"start":{"line":131,"column":1},"end":{"line":131,"column":1}},"key":"L1tfauKiaB"}],"key":"T5IWxGVntO"},{"type":"heading","depth":2,"position":{"start":{"line":137,"column":1},"end":{"line":137,"column":1}},"children":[{"type":"text","value":"The TCV Formulation","position":{"start":{"line":137,"column":1},"end":{"line":137,"column":1}},"key":"WAxUEUUS9X"}],"identifier":"the-tcv-formulation","label":"The TCV Formulation","html_id":"the-tcv-formulation","implicit":true,"key":"buFOmVkzGz"},{"type":"paragraph","position":{"start":{"line":139,"column":1},"end":{"line":146,"column":1}},"children":[{"type":"text","value":"TCV’s simulator combined conductor-circuit dynamics, a free-boundary plasma\nmodel, and lumped plasma-current dynamics. Data-identified sensor and\npower-supply models\nrepresented filtering, delays, measurement noise, and voltage offsets.\nExperimentally informed parameter ranges represented uncertainty, while the\nobjective and termination rules represented operating requirements. After\nhandover, the learned policy acted as the feedback controller within this\nspecified system.","position":{"start":{"line":139,"column":1},"end":{"line":139,"column":1}},"key":"oWBfs6rX3o"}],"key":"QzrVCS2auD"},{"type":"paragraph","position":{"start":{"line":148,"column":1},"end":{"line":154,"column":1}},"children":[{"type":"text","value":"Reinforcement learning used the physical model and the conventional\nplasma-formation controller rather than replacing them. A detailed physical\nsimulator is not required in every application, but available structure remains\nuseful when it determines feasible actions, conserved quantities, or safety\nconstraints. The same division appears in safe robot control, where nominal\ndynamics, costs, and constraints encode prior knowledge and uncertain\ncomponents are learned from data ","position":{"start":{"line":148,"column":1},"end":{"line":148,"column":1}},"key":"bcnZHBE1Kh"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"Brunke2022","identifier":"brunke2022","children":[{"type":"text","value":"Brunke ","key":"j6wpmk0G6R"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"vyqOgeRkzv"}],"key":"WdhT5YbDVW"},{"type":"text","value":", 2022","key":"Y6aSo8AFFO"}],"enumerator":"3","key":"GAiJ0eJN5R"}],"key":"SEzKtoVi9H"},{"type":"text","value":".","position":{"start":{"line":148,"column":1},"end":{"line":148,"column":1}},"key":"qTLF4JmLm7"}],"key":"IBXRmgTJc8"},{"type":"paragraph","position":{"start":{"line":156,"column":1},"end":{"line":161,"column":1}},"children":[{"type":"text","value":"Real systems also impose limited samples, delays, safety constraints, partial\nobservability, stochasticity, nonstationarity, multiple objectives, real-time\naction selection, and distribution shift ","position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"key":"Y7h10IPbsQ"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"DulacArnold2021","identifier":"dulacarnold2021","children":[{"type":"text","value":"Dulac-Arnold ","key":"T1EsH2VqIp"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"PCumeDnR7A"}],"key":"xP2jNy1YYv"},{"type":"text","value":", 2021","key":"Qy5HXsgCge"}],"enumerator":"4","key":"xMndIKInOd"}],"key":"GaUtGXOcv2"},{"type":"text","value":". These\nconditions affect the formulation itself. They determine which state is\npredictive, which action is feasible, which data support evaluation, and which\nclaim a successful experiment can justify.","position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"key":"NlJXrTsGm3"}],"key":"U85lK97FjR"},{"type":"heading","depth":2,"position":{"start":{"line":163,"column":1},"end":{"line":163,"column":1}},"children":[{"type":"text","value":"Relation to Reinforcement-Learning Theory","position":{"start":{"line":163,"column":1},"end":{"line":163,"column":1}},"key":"IS1HrAflcd"}],"identifier":"relation-to-reinforcement-learning-theory","label":"Relation to Reinforcement-Learning Theory","html_id":"relation-to-reinforcement-learning-theory","implicit":true,"key":"yuJ2QmR5RK"},{"type":"paragraph","position":{"start":{"line":165,"column":1},"end":{"line":169,"column":1}},"children":[{"type":"text","value":"Bellman equations, dynamic programming, Monte Carlo and temporal-difference\nmethods, value-function approximation, and policy gradients all begin from a\nspecified sequential decision interface. These foundations occupy the second\nhalf of the book. The earlier chapters study the modeling and control steps\nthat construct and test that interface.","position":{"start":{"line":165,"column":1},"end":{"line":165,"column":1}},"key":"mGGZjo6amY"}],"key":"uEnj9DqyUV"},{"type":"paragraph","position":{"start":{"line":171,"column":1},"end":{"line":175,"column":1}},"children":[{"type":"text","value":"Known dynamics and constraints permit trajectory optimization from a particular\ninitial condition. Repeated optimization converts such plans into feedback.\nDynamic programming computes state-contingent decisions across possible future\nstates, and approximation becomes necessary when the required model, value\nfunction, or policy is unknown or too expensive to represent exactly.","position":{"start":{"line":171,"column":1},"end":{"line":171,"column":1}},"key":"uWqFYChRUI"}],"key":"sAm1RjeyZR"},{"type":"paragraph","position":{"start":{"line":177,"column":1},"end":{"line":182,"column":1}},"children":[{"type":"text","value":"Both model-free and model-based reinforcement learning begin from a specified\ninterface. If only transitions and rewards are available, sample-based methods\ncan operate on that interface. If equations, geometry, conservation laws, or\nhard constraints are also available, they can remain explicit. With a partial\nmodel, data can estimate uncertain parameters, residual dynamics, value\nfunctions, or policies without replacing the known structure.","position":{"start":{"line":177,"column":1},"end":{"line":177,"column":1}},"key":"RDsGoaybEZ"}],"key":"sg9WiLf04c"},{"type":"heading","depth":2,"position":{"start":{"line":184,"column":1},"end":{"line":184,"column":1}},"children":[{"type":"text","value":"Formulating the Decision Problem","position":{"start":{"line":184,"column":1},"end":{"line":184,"column":1}},"key":"oUxkWhz6RS"}],"identifier":"formulating-the-decision-problem","label":"Formulating the Decision Problem","html_id":"formulating-the-decision-problem","implicit":true,"key":"iO9KW16aGm"},{"type":"paragraph","position":{"start":{"line":186,"column":1},"end":{"line":187,"column":1}},"children":[{"type":"text","value":"A sequential decision problem must answer five questions before an algorithm\ncan solve it:","position":{"start":{"line":186,"column":1},"end":{"line":186,"column":1}},"key":"szivr24acQ"}],"key":"LqfoEoaax8"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":189,"column":1},"end":{"line":194,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":189,"column":1},"end":{"line":189,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Which variables summarize the information needed for future decisions?","position":{"start":{"line":189,"column":1},"end":{"line":189,"column":1}},"key":"OLK8k4NbIn"}],"key":"obVRJnGAKu"}],"key":"bzOS6mrjEY"},{"type":"listItem","spread":true,"position":{"start":{"line":190,"column":1},"end":{"line":190,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Which actions can the decision maker actually apply?","position":{"start":{"line":190,"column":1},"end":{"line":190,"column":1}},"key":"fzuIzDXp6n"}],"key":"XaER8Kmb4a"}],"key":"xEBa7BsHA1"},{"type":"listItem","spread":true,"position":{"start":{"line":191,"column":1},"end":{"line":191,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"How do actions, disturbances, and uncertainty change the system?","position":{"start":{"line":191,"column":1},"end":{"line":191,"column":1}},"key":"S90RpuLzpC"}],"key":"sui0IwqkG0"}],"key":"bgSxXslL72"},{"type":"listItem","spread":true,"position":{"start":{"line":192,"column":1},"end":{"line":192,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Which outcomes should the objective reward or penalize?","position":{"start":{"line":192,"column":1},"end":{"line":192,"column":1}},"key":"wlYed5CtdP"}],"key":"hAorLmF928"}],"key":"lsTVbLccKp"},{"type":"listItem","spread":true,"position":{"start":{"line":193,"column":1},"end":{"line":194,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Which physical, operational, or safety constraints must always hold?","position":{"start":{"line":193,"column":1},"end":{"line":193,"column":1}},"key":"Pqgfipz08o"}],"key":"KimLKkVlhK"}],"key":"bnetsiL8Tx"}],"key":"Hn94hgcn6X"},{"type":"paragraph","position":{"start":{"line":195,"column":1},"end":{"line":200,"column":1}},"children":[{"type":"text","value":"The answers determine which computations and claims are available. An explicit\ndifferential equation exposes derivatives and conservation laws. A simulator\nmay expose only reset and transition operations. Logged data cannot answer\narbitrary counterfactual questions without additional assumptions. Live\ninteraction supplies new data, but collecting it consumes time and may damage\nthe system.","position":{"start":{"line":195,"column":1},"end":{"line":195,"column":1}},"key":"iUqK0CCndU"}],"key":"VkPVpKJlyo"},{"type":"heading","depth":2,"position":{"start":{"line":202,"column":1},"end":{"line":202,"column":1}},"children":[{"type":"text","value":"Book Structure","position":{"start":{"line":202,"column":1},"end":{"line":202,"column":1}},"key":"tIPy6yEwOj"}],"identifier":"book-structure","label":"Book Structure","html_id":"book-structure","implicit":true,"key":"l81Ubp46jB"},{"type":"paragraph","position":{"start":{"line":204,"column":1},"end":{"line":207,"column":1}},"children":[{"type":"text","value":"The technical development follows the information available about the decision\nproblem. Every later method depends on some account of how actions lead to future\nobservations, whether supplied by equations, a simulator, logged transitions, or\nlive interaction.","position":{"start":{"line":204,"column":1},"end":{"line":204,"column":1}},"key":"vkRSelepZL"}],"key":"fZxUcyYV8y"},{"type":"table","position":{"start":{"line":209,"column":1},"end":{"line":216,"column":1}},"children":[{"type":"tableRow","position":{"start":{"line":209,"column":1},"end":{"line":209,"column":1}},"children":[{"type":"tableCell","header":true,"position":{"start":{"line":209,"column":1},"end":{"line":209,"column":1}},"children":[{"type":"text","value":"Part","position":{"start":{"line":209,"column":1},"end":{"line":209,"column":1}},"key":"QHmMMbP3I8"}],"key":"CkLGFS0zVw"},{"type":"tableCell","header":true,"position":{"start":{"line":209,"column":1},"end":{"line":209,"column":1}},"children":[{"type":"text","value":"Question","position":{"start":{"line":209,"column":1},"end":{"line":209,"column":1}},"key":"ItBWkAWMDp"}],"key":"zY5WwTklsL"},{"type":"tableCell","header":true,"position":{"start":{"line":209,"column":1},"end":{"line":209,"column":1}},"children":[{"type":"text","value":"Result","position":{"start":{"line":209,"column":1},"end":{"line":209,"column":1}},"key":"bt79RHwshB"}],"key":"OfBM01InM5"}],"key":"nkNcKAv008"},{"type":"tableRow","position":{"start":{"line":211,"column":1},"end":{"line":211,"column":1}},"children":[{"type":"tableCell","position":{"start":{"line":211,"column":1},"end":{"line":211,"column":1}},"children":[{"type":"text","value":"Modeling sequential decisions","position":{"start":{"line":211,"column":1},"end":{"line":211,"column":1}},"key":"RAlpN0qw0t"}],"key":"kEzvbEmuZV"},{"type":"tableCell","position":{"start":{"line":211,"column":1},"end":{"line":211,"column":1}},"children":[{"type":"text","value":"What evolves, what can be observed, and where does an action enter?","position":{"start":{"line":211,"column":1},"end":{"line":211,"column":1}},"key":"B7eWxq6kse"}],"key":"LVPmaci4VR"},{"type":"tableCell","position":{"start":{"line":211,"column":1},"end":{"line":211,"column":1}},"children":[{"type":"text","value":"A state, action, disturbance, objective, constraint set, and model interface","position":{"start":{"line":211,"column":1},"end":{"line":211,"column":1}},"key":"AdesoD1R5e"}],"key":"zyYNzqEwGB"}],"key":"GoDuDcKY3P"},{"type":"tableRow","position":{"start":{"line":212,"column":1},"end":{"line":212,"column":1}},"children":[{"type":"tableCell","position":{"start":{"line":212,"column":1},"end":{"line":212,"column":1}},"children":[{"type":"text","value":"Trajectory optimization","position":{"start":{"line":212,"column":1},"end":{"line":212,"column":1}},"key":"EgZyIAXncV"}],"key":"SjX7pRMLLs"},{"type":"tableCell","position":{"start":{"line":212,"column":1},"end":{"line":212,"column":1}},"children":[{"type":"text","value":"What action sequence performs well from one initial condition?","position":{"start":{"line":212,"column":1},"end":{"line":212,"column":1}},"key":"zAgCx9Fak3"}],"key":"zTQvOkEigP"},{"type":"tableCell","position":{"start":{"line":212,"column":1},"end":{"line":212,"column":1}},"children":[{"type":"text","value":"A finite-horizon plan and the conditions and numerical methods used to compute it","position":{"start":{"line":212,"column":1},"end":{"line":212,"column":1}},"key":"aryHrPVaMP"}],"key":"HI2ckUXhvF"}],"key":"M8GBpbwFZy"},{"type":"tableRow","position":{"start":{"line":213,"column":1},"end":{"line":213,"column":1}},"children":[{"type":"tableCell","position":{"start":{"line":213,"column":1},"end":{"line":213,"column":1}},"children":[{"type":"text","value":"Model predictive control","position":{"start":{"line":213,"column":1},"end":{"line":213,"column":1}},"key":"RoChZpAX6B"}],"key":"ZGEnyzvWXr"},{"type":"tableCell","position":{"start":{"line":213,"column":1},"end":{"line":213,"column":1}},"children":[{"type":"text","value":"How can the plan respond when measurements reveal a different state?","position":{"start":{"line":213,"column":1},"end":{"line":213,"column":1}},"key":"GpXxfW8OtX"}],"key":"MnZufopCga"},{"type":"tableCell","position":{"start":{"line":213,"column":1},"end":{"line":213,"column":1}},"children":[{"type":"text","value":"Closed-loop behavior through repeated replanning","position":{"start":{"line":213,"column":1},"end":{"line":213,"column":1}},"key":"WlU3QaGUDg"}],"key":"RzGcLeF7f1"}],"key":"VoOsEv5WlX"},{"type":"tableRow","position":{"start":{"line":214,"column":1},"end":{"line":214,"column":1}},"children":[{"type":"tableCell","position":{"start":{"line":214,"column":1},"end":{"line":214,"column":1}},"children":[{"type":"text","value":"Dynamic programming","position":{"start":{"line":214,"column":1},"end":{"line":214,"column":1}},"key":"oshZE3bx75"}],"key":"a1n5iu7dV9"},{"type":"tableCell","position":{"start":{"line":214,"column":1},"end":{"line":214,"column":1}},"children":[{"type":"text","value":"Can state-contingent decisions be computed before the state is observed?","position":{"start":{"line":214,"column":1},"end":{"line":214,"column":1}},"key":"f9xPWRnFFF"}],"key":"vzLhC6TiEJ"},{"type":"tableCell","position":{"start":{"line":214,"column":1},"end":{"line":214,"column":1}},"children":[{"type":"text","value":"Value functions and policies defined over many possible states","position":{"start":{"line":214,"column":1},"end":{"line":214,"column":1}},"key":"wDVMHTzOAn"}],"key":"ZFNXWSn0oC"}],"key":"B5gralc2Si"},{"type":"tableRow","position":{"start":{"line":215,"column":1},"end":{"line":215,"column":1}},"children":[{"type":"tableCell","position":{"start":{"line":215,"column":1},"end":{"line":215,"column":1}},"children":[{"type":"text","value":"Approximate dynamic programming (within dynamic programming)","position":{"start":{"line":215,"column":1},"end":{"line":215,"column":1}},"key":"XJKQTfRhAK"}],"key":"EKcXMRQ4im"},{"type":"tableCell","position":{"start":{"line":215,"column":1},"end":{"line":215,"column":1}},"children":[{"type":"text","value":"How can Bellman equations be solved when their functions or expectations cannot be represented exactly?","position":{"start":{"line":215,"column":1},"end":{"line":215,"column":1}},"key":"duL7MVyGcd"}],"key":"aVZDubgUCq"},{"type":"tableCell","position":{"start":{"line":215,"column":1},"end":{"line":215,"column":1}},"children":[{"type":"text","value":"Projected, sampled, and fitted value functions","position":{"start":{"line":215,"column":1},"end":{"line":215,"column":1}},"key":"w5scMyq0OJ"}],"key":"HzcPJlMeQj"}],"key":"zgKxrDuY3U"},{"type":"tableRow","position":{"start":{"line":216,"column":1},"end":{"line":216,"column":1}},"children":[{"type":"tableCell","position":{"start":{"line":216,"column":1},"end":{"line":216,"column":1}},"children":[{"type":"text","value":"Policy optimization","position":{"start":{"line":216,"column":1},"end":{"line":216,"column":1}},"key":"wUJkcoRB9e"}],"key":"cYUtnDbfKy"},{"type":"tableCell","position":{"start":{"line":216,"column":1},"end":{"line":216,"column":1}},"children":[{"type":"text","value":"How can a restricted policy class be optimized when action selection or return evaluation is intractable?","position":{"start":{"line":216,"column":1},"end":{"line":216,"column":1}},"key":"f7TQeeF2fX"}],"key":"J1u2XI79XY"},{"type":"tableCell","position":{"start":{"line":216,"column":1},"end":{"line":216,"column":1}},"children":[{"type":"text","value":"Amortized action selectors, actor-critic methods, and direct policy gradients","position":{"start":{"line":216,"column":1},"end":{"line":216,"column":1}},"key":"p59aIwxaHO"}],"key":"bnpnJxHZHZ"}],"key":"yUc9LTBgIw"}],"key":"z1eb2Wm3Ia"},{"type":"paragraph","position":{"start":{"line":218,"column":1},"end":{"line":221,"column":1}},"children":[{"type":"text","value":"This order does not assume a complete mechanistic model. It keeps the available\ninformation explicit: known conservation laws, geometry, and constraints stay\nin the formulation, while uncertain parameters, residual dynamics, value\nfunctions, or policies become learning targets.","position":{"start":{"line":218,"column":1},"end":{"line":218,"column":1}},"key":"sE7sCny5Di"}],"key":"Uy3KmrTBur"},{"type":"paragraph","position":{"start":{"line":223,"column":1},"end":{"line":228,"column":1}},"children":[{"type":"text","value":"Model predictive control is the book’s first closed-loop construction: a new\nfinite-horizon plan is computed from each measured state. Dynamic programming\nbuilds feedback differently by solving for decisions across a family of states.\nFunction approximation and stochastic optimization then make those closed-loop\nobjects computable when exact value functions, expectations, or action searches\nare unavailable.","position":{"start":{"line":223,"column":1},"end":{"line":223,"column":1}},"key":"hzlgEIOhpF"}],"key":"J0JUoJWmxH"},{"type":"paragraph","position":{"start":{"line":230,"column":1},"end":{"line":232,"column":1}},"children":[{"type":"text","value":"These structures recur in reinforcement learning, control theory, and\noperations research, which permits methods to move between fields when the\nassumptions attached to them are preserved.","position":{"start":{"line":230,"column":1},"end":{"line":230,"column":1}},"key":"YCOagwKppi"}],"key":"YgarY3JnQ3"},{"type":"heading","depth":2,"position":{"start":{"line":234,"column":1},"end":{"line":234,"column":1}},"children":[{"type":"text","value":"How to Use This Book","position":{"start":{"line":234,"column":1},"end":{"line":234,"column":1}},"key":"Ok29J5nYUf"}],"identifier":"how-to-use-this-book","label":"How to Use This Book","html_id":"how-to-use-this-book","implicit":true,"key":"P5t9U4sdiw"},{"type":"paragraph","position":{"start":{"line":236,"column":1},"end":{"line":242,"column":1}},"children":[{"type":"text","value":"The chapters are cumulative, but each begins with its prerequisites and points\nto the relevant review material. Readers with a reinforcement-learning\nbackground may find the modeling and trajectory-optimization chapters less\nfamiliar. Readers from control may need more time with Bellman operators,\nsampling, and function approximation. The appendices provide concise reviews of\ninitial-value problems and nonlinear programming when those tools first become\nnecessary.","position":{"start":{"line":236,"column":1},"end":{"line":236,"column":1}},"key":"A6FI3dEvV4"}],"key":"it4rfHY6uW"},{"type":"paragraph","position":{"start":{"line":244,"column":1},"end":{"line":248,"column":1}},"children":[{"type":"text","value":"Derivations are part of the argument rather than decorative verification.\nPause before a nontrivial step, attempt it on paper, and then compare the result\nwith the text. Work through the short self-checks while the notation is still\nactive. The longer exercises are intended for a second pass and often connect\nseveral chapters.","position":{"start":{"line":244,"column":1},"end":{"line":244,"column":1}},"key":"nn2tmsjOLx"}],"key":"TsVRB1cD70"},{"type":"paragraph","position":{"start":{"line":250,"column":1},"end":{"line":254,"column":1}},"children":[{"type":"text","value":"The computational examples answer specific modeling or algorithmic questions.\nTheir source, parameters, and recorded artifacts are provided so that the\nresult can be inspected and modified. Running every example is optional, but a\nnumerical result should be read together with the assumptions and diagnostic\nthat support it.","position":{"start":{"line":250,"column":1},"end":{"line":250,"column":1}},"key":"Wjux8MS6sV"}],"key":"FfxLJFTQa2"},{"type":"heading","depth":2,"position":{"start":{"line":256,"column":1},"end":{"line":256,"column":1}},"children":[{"type":"text","value":"Self-checks","position":{"start":{"line":256,"column":1},"end":{"line":256,"column":1}},"key":"GBkjokortv"}],"identifier":"self-checks","label":"Self-checks","html_id":"self-checks","implicit":true,"key":"oHuCEDKTXc"},{"type":"exercise","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Problem before algorithm","position":{"start":{"line":258,"column":1},"end":{"line":258,"column":1}},"key":"YmFyJz1UbI"}],"key":"XvqQ7EumJo"},{"type":"paragraph","position":{"start":{"line":261,"column":1},"end":{"line":261,"column":1}},"children":[{"type":"text","value":"A production controller must respect a hard storage limit. Is selecting a learning algorithm enough to define the reinforcement-learning problem? Name two pieces of structure that must be specified first.","position":{"start":{"line":261,"column":1},"end":{"line":261,"column":1}},"key":"fJJ3l9Gmff"}],"key":"zopUeIfXxJ"}],"label":"ex-intro-check-1","identifier":"ex-intro-check-1","enumerated":true,"enumerator":"1","html_id":"ex-intro-check-1","key":"eBJEqr5lO6"},{"type":"solution","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Solution to ","key":"X9YaHdt1TK"},{"type":"crossReference","label":"ex-intro-check-1","identifier":"ex-intro-check-1","kind":"exercise","children":[{"type":"text","value":"Exercise ","key":"TCUi4Dgm39"},{"type":"text","value":"1","key":"MDlvm9Usjg"}],"template":"Exercise %s","enumerator":"1","resolved":true,"html_id":"ex-intro-check-1","key":"DR3VNfPC4L"}],"key":"Ipa3FzIpYi"},{"type":"paragraph","position":{"start":{"line":267,"column":1},"end":{"line":267,"column":1}},"children":[{"type":"text","value":"No. At minimum, the state and available decisions must be defined, together with the objective and the hard storage constraint. The transition or feedback structure must also say how decisions affect future states.","position":{"start":{"line":267,"column":1},"end":{"line":267,"column":1}},"key":"WmaFVgsQpu"}],"key":"zGA5bl3T5y"}],"class":"dropdown","key":"K0kJRM6iIR"},{"type":"exercise","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Shared structure","position":{"start":{"line":270,"column":1},"end":{"line":270,"column":1}},"key":"mhhLoxaEjG"}],"key":"sE0ICMcxgs"},{"type":"paragraph","position":{"start":{"line":273,"column":1},"end":{"line":273,"column":1}},"children":[{"type":"text","value":"What feature makes trajectory optimization, model predictive control, and reinforcement learning members of the same decision-making family?","position":{"start":{"line":273,"column":1},"end":{"line":273,"column":1}},"key":"IlWSnpz628"}],"key":"iJMnSj7DOa"}],"label":"ex-intro-check-2","identifier":"ex-intro-check-2","enumerated":true,"enumerator":"2","html_id":"ex-intro-check-2","key":"LrNxY9sQKd"},{"type":"solution","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Solution to ","key":"Jskx5upZsn"},{"type":"crossReference","label":"ex-intro-check-2","identifier":"ex-intro-check-2","kind":"exercise","children":[{"type":"text","value":"Exercise ","key":"aHFoWHKQOb"},{"type":"text","value":"2","key":"V0lIGNJlpT"}],"template":"Exercise %s","enumerator":"2","resolved":true,"html_id":"ex-intro-check-2","key":"x03Rdamxnq"}],"key":"BBGTXyHwI7"},{"type":"paragraph","position":{"start":{"line":279,"column":1},"end":{"line":279,"column":1}},"children":[{"type":"text","value":"All three choose actions whose consequences unfold through a dynamical system over time, so present decisions must account for future objectives and constraints.","position":{"start":{"line":279,"column":1},"end":{"line":279,"column":1}},"key":"eBcwmpk7KE"}],"key":"r26ppRDnA5"}],"class":"dropdown","key":"QqbsgfAzWj"},{"type":"exercise","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Available information","position":{"start":{"line":282,"column":1},"end":{"line":282,"column":1}},"key":"jmZlMAys3S"}],"key":"M6oZ73Pat1"},{"type":"paragraph","position":{"start":{"line":285,"column":1},"end":{"line":288,"column":1}},"children":[{"type":"text","value":"Suppose an environment already supplies a Markov state, an action set, a reward,\nand a transition sampler. Which formulation work has already been done? What\nadditional computations become possible if differentiable dynamics and hard\nconstraints are also available?","position":{"start":{"line":285,"column":1},"end":{"line":285,"column":1}},"key":"dAwv6CVSzq"}],"key":"djrXuwUhhB"}],"label":"ex-intro-check-3","identifier":"ex-intro-check-3","enumerated":true,"enumerator":"3","html_id":"ex-intro-check-3","key":"RZpSG1jaBH"},{"type":"solution","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Solution to ","key":"f145cMR7oL"},{"type":"crossReference","label":"ex-intro-check-3","identifier":"ex-intro-check-3","kind":"exercise","children":[{"type":"text","value":"Exercise ","key":"KfRizZr5qb"},{"type":"text","value":"3","key":"B0DBPUztvQ"}],"template":"Exercise %s","enumerator":"3","resolved":true,"html_id":"ex-intro-check-3","key":"arN4SzSP4g"}],"key":"XSg0fiA13s"},{"type":"paragraph","position":{"start":{"line":294,"column":1},"end":{"line":300,"column":1}},"children":[{"type":"text","value":"The environment designer has selected a boundary, state representation, actions,\ntransition interface, and reward, although those choices may still need to be\naudited against the intended application. Sample-based reinforcement-learning\nmethods can operate on that interface. Differentiable dynamics and explicit\nconstraints also permit direct trajectory optimization, model predictive\ncontrol, local feedback design, and model-based dynamic programming when their\nother assumptions are satisfied.","position":{"start":{"line":294,"column":1},"end":{"line":294,"column":1}},"key":"xNoaSMlyck"}],"key":"Xx9wTx8g7O"}],"class":"dropdown","key":"d0ofYEnQQ3"}],"key":"cUU435Fg1q"},{"type":"anywidget","id":"rl-presenter-launcher","esm":"/rlbook/build/presenter-launcher-b320a9747567d4bee90650993ba4dd4e.mjs","model":{},"key":"Uj4TRtzooz"}],"key":"AZiNm0TnO1"},"references":{"cite":{"order":["Degrave2022","SuttonBarto2018","Brunke2022","DulacArnold2021"],"data":{"Degrave2022":{"label":"Degrave2022","enumerator":"1","doi":"10.1038/s41586-021-04301-9","html":"Degrave, J., Felici, F., Buchli, J., Neunert, M., Tracey, B., Carpanese, F., Ewalds, T., Hafner, R., Abdolmaleki, A., de las Casas, D., Donner, C., Fritz, L., Galperti, C., Huber, A., Keeling, J., Tsimpoukelli, M., Kay, J., Merle, A., Moret, J.-M., … Riedmiller, M. (2022). Magnetic Control of Tokamak Plasmas through Deep Reinforcement Learning. <i>Nature</i>, <i>602</i>(7897), 414–419. <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.1038/s41586-021-04301-9\">10.1038/s41586-021-04301-9</a>","url":"https://doi.org/10.1038/s41586-021-04301-9"},"SuttonBarto2018":{"label":"SuttonBarto2018","enumerator":"2","html":"Sutton, R. S., & Barto, A. G. (2018). <i>Reinforcement Learning: An Introduction</i> (2nd ed.). MIT Press. <a target=\"_blank\" rel=\"noreferrer\" href=\"http://incompleteideas.net/book/the-book-2nd.html\">http://incompleteideas.net/book/the-book-2nd.html</a>","url":"http://incompleteideas.net/book/the-book-2nd.html"},"Brunke2022":{"label":"Brunke2022","enumerator":"3","doi":"10.1146/annurev-control-042920-020211","html":"Brunke, L., Greeff, M., Hall, A. W., Yuan, Z., Zhou, S., Panerati, J., & Schoellig, A. P. (2022). Safe Learning in Robotics: From Learning-Based Control to Safe Reinforcement Learning. <i>Annual Review of Control, Robotics, and Autonomous Systems</i>, <i>5</i>(1), 411–444. <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.1146/annurev-control-042920-020211\">10.1146/annurev-control-042920-020211</a>","url":"https://doi.org/10.1146/annurev-control-042920-020211"},"DulacArnold2021":{"label":"DulacArnold2021","enumerator":"4","doi":"10.1007/s10994-021-05961-4","html":"Dulac-Arnold, G., Levine, N., Mankowitz, D. J., Li, J., Paduraru, C., Gowal, S., & Hester, T. (2021). Challenges of Real-World Reinforcement Learning: Definitions, Benchmarks and Analysis. <i>Machine Learning</i>, <i>110</i>(9), 2419–2468. <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.1007/s10994-021-05961-4\">10.1007/s10994-021-05961-4</a>","url":"https://doi.org/10.1007/s10994-021-05961-4"}}}},"footer":{"navigation":{"next":{"title":"Syllabus · Plan de cours","url":"/syllabus","group":"Building Up RL: From Dynamics and Control to Learning"}}},"domain":"http://localhost:3001"}